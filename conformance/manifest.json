{
  "version": 1,
  "areas": {
    "board": {
      "specifies": "S1 board parity: scenarios.json lists board states built on both sides; mod-answers.json is what the mod's own code made of each (its SolveInput, answer and board readouts), which the website must reproduce.",
      "readers": [
        "website: src/lib/solver/plan/parity/scenarios.test.ts"
      ],
      "generator": "mod-answers.json: tools/parity/s1/README.md (S1ParityTest, a throwaway JUnit run in a mod checkout)"
    },
    "layout": {
      "specifies": "The wire router: every router call the website's router tests make (router-tests.json: solves with boards in and routes out, IncrementalRouter step sequences, cardRimDocks vectors) and the reference boards (boards.json.gz: the layout benchmark's plans as boxes and wires, each routed fresh, its busiest box dragged three beats and dropped), all answered by the website's TypeScript router; the Java router (core-layout) must give the same routes and search work to the bit.",
      "readers": [
        "jvm: core-layout com.gtnhplanner.core.layout.RouterConformanceTest"
      ],
      "generator": "node tools/conformance/layout/generate.mjs [--boards jvm/mod/build/bench/versus/boards]"
    },
    "live": {
      "specifies": "The live-plan op engine: every rule of put, patch, del, meta, apply, diff and invert as a vector (plan, ops, expected result), run by both engines.",
      "readers": [
        "website: src/lib/live/ops.test.ts",
        "mod: cloud/sync/LiveVectorsTest"
      ],
      "generator": "hand-written"
    },
    "machines": {
      "specifies": "Machine maths as the website computes it: machine-goldens (recipes through the machine table, overclocks, parallels, power), bee-goldens (the bee card's multipliers and handler stats), crop-goldens (CropsNh), and reference-coefficients (the machine table against ShadowTheAge's reference calculator). Gzip files are one JSON object per line.",
      "readers": [
        "mod: machines/web/MachineGoldensTest, machines/BeesGoldensTest, machines/CropsNhGoldensTest, machines/web/MachineTableTest",
        "website: src/lib/machines/machine-table.test.ts (reference-coefficients.json)"
      ],
      "generator": "bee-goldens: jvm/mod/tools/dev/bees/vitest.bees.config.mjs; reference-coefficients: see src/lib/machines/CLAUDE.md; machine-goldens and crop-goldens have no generator in this repository"
    },
    "pending": {
      "specifies": "Files that disagree with a copy in the tree and wait for a decision. No suite reads them. Each subdirectory says in its README.md what it is and which file it would replace.",
      "readers": []
    },
    "solver/corpus": {
      "specifies": "The solver's whole answer on a plan. inputs/<case>.json is a SolveInput as the mod's SolveInputJson writes it; goldens/<case>.json is the digest of the answer both solvers must give, equal to 1e-6 relative. platline-x4 and platline-x10 have a golden only: their input is platline tiled 4 and 10 times. The 16 gtnh-flow-* inputs are dumps of yaml charts the mod loads itself.",
      "readers": [
        "website: src/lib/solver/plan/__fixtures__/{harness,golden}.test.ts, src/lib/solver/plan/adapter/parity.test.ts",
        "mod: solver/SolverGoldenTest, solver/SolverCorpus (every solver test), solver/BufferDrawerTest, cloud/map/Boards, data/flowchart/balancer/AnswerAudit"
      ],
      "generator": "goldens and buffer-drawers.json: ./gradlew :mod:test --tests '*SolverGoldenTest*' --tests '*BufferDrawerTest*' -PwriteGoldens (from jvm/); other inputs: the mod's /solvedump command"
    },
    "solver/up-to": {
      "specifies": "Up to parity: each file is {name, input, answer}, a plan the website's engine solved, for the mod's engine to solve again and match by the golden rules. Hand-built Up to plans plus every corpus plan with each exact count turned Up to.",
      "readers": [
        "mod: solver/UpToParityTest, solver/SolverCorpus.upToCases"
      ],
      "generator": "UPTO_EXPORT_DIR=$PWD/conformance/solver/up-to npx vitest run up-to-export (website), then node tools/conformance/manifest.mjs --write"
    },
    "tasks": {
      "specifies": "Task order keys: orderBetween answers for pairs of keys, so both sides sort a task list the same way.",
      "readers": [
        "website: src/lib/tasks/order-key.test.ts",
        "core-base: data/flowchart/OrderKeysTest"
      ],
      "generator": "website: src/lib/tasks/order-key.ts"
    }
  },

      ],
      "offered": "item:minecraft:planks@1",
      "takes": true
    },
    {
      "name": "an item the slot does not list",
      "slot": "item:minecraft:planks",
      "alternatives": [
        "item:minecraft:planks",
        "item:minecraft:planks@1"
      ],
      "offered": "item:minecraft:wooden_slab",
      "takes": false
    },
    {
      "name": "an ore dictionary slot takes its listed members",
      "slot": "item:oredict:plankwood",
      "alternatives": [
        "item:minecraft:planks@32767",
        "item:minecraft:planks@3"
      ],
      "offered": "item:minecraft:planks@3",
      "takes": true
    },
    {
      "name": "an ore dictionary slot with no list takes only itself",
      "slot": "item:oredict:plankwood",
      "alternatives": [],
      "offered": "item:minecraft:planks",
      "takes": false
    },
    {
      "name": "an ore dictionary offer feeds the same ore dictionary slot",
      "slot": "item:oredict:plankwood",
      "alternatives": [],
      "offered": "item:oredict:plankwood",
      "takes": true
    },
    {
      "name": "an alternative given as a wildcard",
      "slot": "item:minecraft:log",
      "alternatives": [
        "item:minecraft:log@32767"
      ],
      "offered": "item:minecraft:log@3",
      "takes": true
    },
    {
      "name": "two items that only share an ore name do not wire (Lapis Lazuli into a Lapis Dust slot)",
      "slot": "item:gregtech:gt.metaitem.01@2526",
      "alternatives": [],

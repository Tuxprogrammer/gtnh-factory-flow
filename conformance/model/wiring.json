{
  "specifies": "Which wires a plan allows: a slot takes its own resource and what its recipe lists in its place, and nothing that only shares an ore name with them (parity decision: by the slot's own alternatives). Keys are the plan JSON's kind:id.",
  "cases": [
    {
      "name": "the same item",
      "slot": "item:gregtech:gt.metaitem.01@2377",
      "alternatives": [],
      "offered": "item:gregtech:gt.metaitem.01@2377",
      "takes": true
    },
    {
      "name": "another damage of the item",
      "slot": "item:gregtech:gt.metaitem.01@2377",
      "alternatives": [],
      "offered": "item:gregtech:gt.metaitem.01@2378",
      "takes": false
    },
    {
      "name": "an item never feeds a fluid slot of the same id",
      "slot": "fluid:water",
      "alternatives": [],
      "offered": "item:water",
      "takes": false
    },
    {
      "name": "a filled cell never feeds its fluid's slot",
      "slot": "fluid:water",
      "alternatives": [],
      "offered": "item:ic2:itemcellwater",
      "takes": false
    },
    {
      "name": "a fluid never feeds a cell slot",
      "slot": "item:ic2:itemcellwater",
      "alternatives": [],
      "offered": "fluid:water",
      "takes": false
    },
    {
      "name": "the same fluid",
      "slot": "fluid:molten.iron",
      "alternatives": [],
      "offered": "fluid:molten.iron",
      "takes": true
    },
    {
      "name": "EU feeds EU",
      "slot": "power:eu",
      "alternatives": [],
      "offered": "power:eu",
      "takes": true
    },
    {
      "name": "a wildcard slot takes any damage",
      "slot": "item:minecraft:log@32767",
      "alternatives": [],
      "offered": "item:minecraft:log@1",
      "takes": true
    },
    {
      "name": "a wildcard slot takes the bare damage-0 id",
      "slot": "item:minecraft:log@32767",
      "alternatives": [],
      "offered": "item:minecraft:log",
      "takes": true
    },
    {
      "name": "a wildcard is anchored on @",
      "slot": "item:minecraft:log@32767",
      "alternatives": [],
      "offered": "item:minecraft:log2@1",
      "takes": false
    },
    {
      "name": "a concrete slot takes a wildcard offer",
      "slot": "item:minecraft:log@2",
      "alternatives": [],
      "offered": "item:minecraft:log@32767",
      "takes": true
    },
    {
      "name": "a listed alternative",
      "slot": "item:minecraft:planks",
      "alternatives": [
        "item:minecraft:planks",
        "item:minecraft:planks@1",

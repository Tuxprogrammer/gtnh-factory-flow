        "item:minecraft:planks@2"
      ],
      "offered": "item:minecraft:planks",
      "takes": true
    },
    {
      "name": "an alternative fluid",
      "slot": "fluid:water",
      "alternatives": [
        "fluid:water",
        "fluid:ic2distilledwater"
      ],
      "offered": "fluid:ic2distilledwater",
      "takes": true
    },
    {
      "name": "an alternative of the other kind never counts",
      "slot": "item:ic2:itemcellwater",
      "alternatives": [
        "fluid:water"
      ],
      "offered": "fluid:water",
      "takes": false
    },
    {
      "name": "ids compare exactly: case",
      "slot": "item:minecraft:log",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "productionGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProductionGroup"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactoryNode"
      }
    },
    "storages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactoryStorage"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactoryAnnotation"
      }
    },
    "pockets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactoryPocket"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactoryEdge"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Recipe"
      }
    }
  },
  "required": [
    "nodes",
    "storages",
    "annotations",
    "pockets",
    "edges",
    "recipes"
  ],
  "$defs": {
    "ProductionGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "resourceRules": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "share",
              "import"
            ]
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "FactoryNode": {
      "type": "object",
      "properties": {
        "productionGroupId": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "recipeId": {
          "type": "string",
          "minLength": 1
        },
        "colorTag": {
          "$ref": "#/$defs/FactoryNodeColorTag"
        },
        "customRate": {
          "type": "object",
          "properties": {
            "perSecond": {
              "type": "number",
              "minimum": 0
            },
            "mode": {
              "type": "string",
              "enum": [
                "supply",
                "request"
              ]
            }
          },
          "required": [
            "perSecond",
            "mode"
          ]
        },
        "cropFullFarmCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "machineCount": {
          "type": "number",
          "minimum": 0
        },
        "parallel": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-normalizedTo": "an integer, at least 1: Math.max(1, Math.round(value)) on load"
        },
        "overclockTier": {
          "type": "string",
          "minLength": 1
        },
        "energyHatches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "energyHatchType": {
          "type": "string",
          "minLength": 1
        },
        "powerEuT": {
          "type": "number",
          "minimum": 0
        },
        "hatchVoltageTier": {
          "type": "string",
          "enum": [
            "ULV",
            "LV",
            "MV",
            "HV",
            "EV",
            "IV",
            "LuV",
            "ZPM",
            "UV",
            "UHV",
            "UEV",
            "UIV",
            "UMV",
            "UXV",
            "MAX"
          ]
        },
        "hatchAmps": {
          "type": "number",
          "minimum": 0
        },
        "powerInputMode": {
          "type": "string",
          "enum": [
            "amps",
            "eut"
          ]
        },
        "machineHandlerId": {
          "type": "string",
          "minLength": 1
        },
        "coilTier": {
          "type": "string",
          "minLength": 1
        },
        "machineConfigTiers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "settingsCollapsed": {
          "type": "boolean"
        },
        "hatchSupplies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "water",
              "air"
            ]
          }
        },
        "recipeInputOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/RecipeInput"
          }
        },
        "extraRecipes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recipeId": {
                "type": "string",
                "minLength": 1
              },
              "recipeInputOverrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "$ref": "#/$defs/RecipeInput"
                }
              }
            },
            "required": [
              "recipeId"
            ]
          }
        },
        "solvePin": {
          "type": "number",
          "minimum": 0
        },
        "solvePinExact": {
          "type": "boolean"
        },
        "portRates": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxProperties": 256
        },
        "targetOutput": {
          "$ref": "#/$defs/TargetRate"
        },
        "enabled": {
          "type": "boolean"
        },
        "pocketId": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "gtnhplanner": {
          "$ref": "#/$defs/GtnhplannerData"
        }
      },
      "required": [
        "id",
        "recipeId",
        "machineCount",
        "parallel",
        "overclockTier",
        "enabled",
        "position"
      ]
    },
    "FactoryNodeColorTag": {
      "type": "string",
      "enum": [
        "white",
        "orange",
        "magenta",
        "light_blue",
        "yellow",
        "lime",
        "pink",
        "gray",
        "light_gray",
        "cyan",
        "purple",
        "blue",
        "brown",
        "green",
        "red",
        "black",
        "scarlet",
        "amber",
        "emerald",
        "azure",
        "steel",
        "onyx"
      ]
    },
    "RecipeInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "iconPath": {
          "type": "string",
          "minLength": 1
        },
        "iconAtlas": {
          "$ref": "#/$defs/ResourceIconAtlasRef"
        },
        "dominantColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "modId": {
          "type": "string",
          "minLength": 1
        },
        "tooltip": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "neiSlot": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/ResourceKind"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "iconPath": {
                "type": "string",
                "minLength": 1
              },
              "iconAtlas": {
                "$ref": "#/$defs/ResourceIconAtlasRef"
              },
              "dominantColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "modId": {
                "type": "string",
                "minLength": 1
              },
              "tooltip": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "id"
            ]
          }
        },
        "optional": {
          "type": "boolean"
        },
        "consumed": {
          "type": "boolean"
        },
        "consumeChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "id",
        "amount"
      ]
    },
    "ResourceKind": {
      "type": "string",
      "enum": [
        "item",
        "fluid",
        "aspect",
        "power"
      ]
    },
    "ResourceIconAtlasRef": {
      "type": "object",
      "properties": {
        "imagePath": {
          "type": "string",
          "minLength": 1
        },
        "atlasWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "atlasHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "dominantColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "imagePath",
        "atlasWidth",
        "atlasHeight",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "TargetRate": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "amountPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resourceId",
        "amountPerSecond"
      ]
    },
    "GtnhplannerData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "x-maxJsonBytes": 65536,
      "x-maxDepth": 63
    },
    "FactoryStorage": {
      "type": "object",
      "properties": {
        "productionGroupId": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "colorTag": {
          "$ref": "#/$defs/FactoryNodeColorTag"
        },
        "displayName": {
          "type": "string"
        },
        "iconPath": {
          "type": "string"
        },
        "iconAtlas": {
          "$ref": "#/$defs/ResourceIconAtlasRef"
        },
        "dominantColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "capacity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "drainMode": {
          "type": "string",
          "enum": [
            "product",
            "byproduct",
            "trash"
          ]
        },
        "bufferMode": {
          "type": "string",
          "enum": [
            "overflow",
            "strict",
            "ratio"
          ]
        },
        "ratioExportPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "poolSide": {
          "type": "string",
          "enum": [
            "source",
            "drain"
          ]
        },
        "targetPerSecond": {
          "type": "number"
        },
        "targetMode": {
          "type": "string",
          "enum": [
            "at-least",
            "at-most",
            "exact",
            "ignore"
          ]
        },
        "poolTargetMode": {
          "type": "string",
          "enum": [
            "at-least",
            "exact",
            "ignore"
          ]
        },
        "pocketId": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "gtnhplanner": {
          "$ref": "#/$defs/GtnhplannerData"
        }
      },
      "required": [
        "id",
        "kind",
        "resourceId",
        "position"
      ]
    },
    "FactoryAnnotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "box",
            "arrow",
            "text",
            "zone",
            "image"
          ]
        },
        "colorTag": {
          "$ref": "#/$defs/FactoryNodeColorTag"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "arrowDirection": {
          "type": "string",
          "enum": [
            "down-right",
            "down-left",
            "up-right",
            "up-left"
          ]
        },
        "arrowHeads": {
          "type": "string",
          "enum": [
            "end",
            "both"
          ]
        },
        "arrowWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "points": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 96
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(https?:\\/\\/|data:image\\/)"
        },
        "style": {
          "type": "object",
          "properties": {
            "border": {
              "type": "string",
              "enum": [
                "solid",
                "dashed",
                "none"
              ]
            },
            "borderColor": {
              "$ref": "#/$defs/FactoryNodeColorTag"
            },
            "fill": {
              "type": "string",
              "enum": [
                "tint",
                "solid",
                "paper",
                "dots",
                "grid",
                "graph",
                "ruled",
                "hatch",
                "none"
              ]
            },
            "fillColor": {
              "$ref": "#/$defs/FactoryNodeColorTag"
            },
            "fillTheme": {
              "type": "string",
              "maxLength": 32
            },
            "marks": {
              "type": "string",
              "enum": [
                "none",
                "dots",
                "grid",
                "graph",
                "ruled",
                "hatch"
              ]
            }
          }
        },
        "pocketId": {
          "type": "string",
          "minLength": 1
        },
        "gtnhplanner": {
          "$ref": "#/$defs/GtnhplannerData"
        }
      },
      "required": [
        "id",
        "kind",
        "position",
        "size"
      ]
    },
    "FactoryPocket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "colorTag": {
          "$ref": "#/$defs/FactoryNodeColorTag"
        },
        "parentPocketId": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "expanded": {
          "type": "boolean"
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "theme": {
          "type": "string",
          "maxLength": 32
        },
        "pattern": {
          "type": "string",
          "maxLength": 16
        },
        "gtnhplanner": {
          "$ref": "#/$defs/GtnhplannerData"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ]
    },
    "FactoryEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sourceHandle": {
          "type": "string"
        },
        "targetHandle": {
          "type": "string"
        },
        "resourceKind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "ratePerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ratioWeight": {
          "type": "number",
          "minimum": 0
        },
        "ratioInputWeight": {
          "type": "number",
          "minimum": 0
        },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        },
        "crossForm": {
          "type": "object",
          "properties": {
            "litresPerCell": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "litresPerCell"
          ]
        },
        "gtnhplanner": {
          "$ref": "#/$defs/GtnhplannerData"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "resourceKind",
        "resourceId"
      ]
    },
    "Recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "gregtech_machine",
            "bee_produce",
            "crop_produce",
            "ore_vein",
            "small_ore",
            "underground_fluid",
            "essentia_smelting",
            "custom",
            "unknown"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "machineType": {
          "type": "string",
          "minLength": 1
        },
        "minimumTier": {
          "type": "string",
          "minLength": 1
        },
        "maximumTier": {
          "type": "string",
          "minLength": 1
        },
        "availableTiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationTicks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "eut": {
          "type": "number",
          "minimum": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeInput"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeOutput"
          }
        },
        "programmedCircuit": {
          "type": "string"
        },
        "specialValue": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        },
        "machineProfile": {
          "$ref": "#/$defs/MachineProfile"
        },
        "machineHandlers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineHandler"
          }
        },
        "machineConfigControls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineConfigControl"
          }
        },
        "power": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "euPerTick": {
              "type": "number"
            },
            "stats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "sourceId",
            "euPerTick",

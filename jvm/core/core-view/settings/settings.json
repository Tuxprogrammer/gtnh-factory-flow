      "mod": { "key": "overview.folded", "getter": "overviewFolded", "setter": "setOverviewFolded", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/OverviewRail.java", "marker": "setOverviewFolded" } }

      "note": "A developer's diagnostic.",
      "mod": { "key": "debugRouteDump", "store": "forge-config", "category": "debug", "control": { "configFile": true } }
    }
  },
  "webStores": {
    "about": "Every source file of the website that calls setItem, so a new persisted thing has to be named here. kind: setting (settings above live here), memory (a panel's open or closed state the player toggles), dev (set from the dev menu), state (not a setting: the plan, a cache, an id, a stamp). A setting, memory or dev entry names the control that changes it (file and a marker found in it); a state entry says why it has none.",
    "files": {
      "src/lib/device-settings.ts": { "kind": "setting" },
      "src/lib/ui-scale.ts": { "kind": "setting" },
      "src/lib/app-font.ts": { "kind": "setting" },
      "src/lib/sound/sfx.ts": { "kind": "setting" },
      "src/components/flow/clean/minimap/minimap-settings.ts": { "kind": "setting" },
      "src/components/flow/board-view.ts": { "kind": "setting" },
      "src/components/flow/board-motion.tsx": { "kind": "setting" },
      "src/components/flow/clean/rail/rail-view.ts": { "kind": "setting" },
      "src/lib/workspace-view.ts": { "kind": "setting" },
      "src/store/factory-store.ts": { "kind": "setting", "also": "the power display unit; the plan itself and the resource history are saved here too (state)" },
      "src/components/flow/clean/tour/tour-store.ts": { "kind": "setting" },
      "src/lib/tasks/task-board-ui.ts": { "kind": "setting" },
      "src/components/PlanIdentityDrawer.tsx": { "kind": "memory", "control": { "file": "src/components/PlanIdentityDrawer.tsx", "marker": "OPEN_STORAGE_KEY" } },
      "src/components/flow/MachineFormulas.tsx": { "kind": "memory", "control": { "file": "src/components/flow/MachineFormulas.tsx", "marker": "MACHINE_FORMULAS_OPEN_KEY" } },
      "src/components/flow/RecipeNode.tsx": { "kind": "memory", "control": { "file": "src/components/flow/RecipeNode.tsx", "marker": "CROP_FORMULAS_OPEN_KEY" } },
      "src/components/flow/FactoryFlow.tsx": { "kind": "memory", "control": { "file": "src/components/flow/FactoryFlow.tsx", "marker": "ARRANGE_KEEP_BOARDS_KEY" } },
      "src/lib/welcome/welcome-tab.ts": { "kind": "memory", "control": { "file": "src/components/welcome/WelcomePage.tsx", "marker": "showOnStartup" } },
      "src/lib/format/setting-memory.ts": { "kind": "memory", "control": { "file": "src/lib/format/setting-memory.ts", "marker": "NOT_KEPT" } },
      "src/lib/whats-new.ts": { "kind": "state", "reason": "the version last seen and the changelog's read stamp; the version chip's unread dot is the control" },
      "src/components/ModAnnouncement.tsx": { "kind": "state", "reason": "when the mod announcement was dismissed; its own close key is the control" },
      "src/components/flow/PerfHud.tsx": { "kind": "dev", "control": { "file": "src/components/DevMenu.tsx", "marker": "PerfHud" } },
      "src/components/flow/board-tilt.ts": { "kind": "dev", "control": { "file": "src/components/DevMenu.tsx", "marker": "Tilt" } },
      "src/components/flow/board-timelapse.ts": { "kind": "dev", "control": { "file": "src/components/DevMenu.tsx", "marker": "imelapse" } },
      "src/components/flow/router-tuning-browser.ts": { "kind": "dev", "control": { "file": "src/components/DevMenu.tsx", "marker": "outer" } },
      "src/components/flow/node-detail.ts": { "kind": "dev", "control": { "file": "src/components/DevMenu.tsx", "marker": "lance" } },
      "src/components/flow/clean/feedback/feedback-model.ts": { "kind": "state", "reason": "a random device name for feedback, made once" },
      "src/lib/community/client.ts": { "kind": "state", "reason": "a random device id for community votes, made once" },
      "src/lib/designs/design-camera.ts": { "kind": "state", "reason": "each design's last camera, saved as it moves" },
      "src/lib/designs/design-storage.ts": { "kind": "state", "reason": "which design is open, and the designs themselves" },
      "src/lib/library/last-open.ts": { "kind": "state", "reason": "when each plan was last opened, for the library's order" },
      "src/lib/library/library-deletes.ts": { "kind": "state", "reason": "library deletes not yet confirmed by the server" },
      "src/lib/library/library-tab.ts": { "kind": "state", "reason": "the library tab's shelf, in the session only" },
      "src/lib/library/saved-setups.ts": { "kind": "state", "reason": "setups the player saved, a list of data" },
      "src/store/live-edit-gate.ts": { "kind": "state", "reason": "which design a live edit was opened on, a stamp" },
      "src/store/design-store.ts": { "kind": "state", "reason": "one-time backfill markers" },
      "src/store/live-session.ts": { "kind": "state", "reason": "the signed-in user's cached profile" }
    }
  }

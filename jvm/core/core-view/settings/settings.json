      "web": { "store": "src/lib/workspace-view.ts", "key": "gtnh-factory-flow-workspace-view", "field": "showHiddenResources", "control": { "file": "src/components/InspectorPanel.tsx", "marker": "writeWorkspaceView({ showHiddenResources:" } }
    },
    "favouritesOnly": {
      "type": "bool",
      "label": "Favourites only",

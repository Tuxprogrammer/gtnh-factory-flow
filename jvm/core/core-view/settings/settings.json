      "min": 108,
      "max": 420,
      "default": 256,
      "scope": "device",
      "parity": "web",
      "note": "NEI's list keeps its own width in the game.",
      "web": { "store": "src/lib/device-settings.ts", "key": "gtnh-factory-flow.device-settings.v1", "field": "itemsWidth", "control": { "file": "src/components/FactoryPlannerApp.tsx", "marker": "{ itemsWidth: width }" } }
    },
    "leftPanelOpen": {
      "type": "bool",
      "label": "Items list open",
      "default": true,
      "note": "True where the window has room; a compact window starts with the side columns closed.",
      "scope": "device",
      "parity": "web",
      "web": { "store": "src/lib/workspace-view.ts", "key": "gtnh-factory-flow-workspace-view", "field": "leftPanelOpen", "control": { "file": "src/components/RecipeBrowser.tsx", "marker": "writeWorkspaceView({ leftPanelOpen: false })" } }
    },
    "rightPanelOpen": {
      "type": "bool",

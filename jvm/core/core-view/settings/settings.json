      "web": { "store": "src/lib/workspace-view.ts", "key": "gtnh-factory-flow-workspace-view", "field": "rightPanelOpen", "control": { "file": "src/components/FactoryPlannerApp.tsx", "marker": "writeWorkspaceView({ rightPanelOpen: false })" } }
    },

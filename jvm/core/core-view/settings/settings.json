{
  "version": 1,
  "about": "Every player setting the website and the mod keep: key, type, default, range or choices, where each side stores it, which side has a control. Read by both sides through generated code (jvm/gradle/settings.gradle.kts, tools/settings/generate.mjs). A value that differs by host is {\"web\": x, \"mod\": y}. docs/view-settings.md is the table of it.",
  "types": "bool | int (min, max, step) | choice (ids, labels, optional values) | set (a list of names)",
  "parity": "shared = both hosts, same meaning; drift = both hosts, different encoding or default (the note says which was picked); web = website only; mod = mod only",
  "scope": "device = kept per browser or per computer, never in a plan; plan-view = also captured into a plan's saved view; per-plan = kept per plan or board on this device",
  "settings": {
    "uiSize": {
      "type": "choice",
      "label": "Size",
      "ids": ["tiny", "small", "normal", "large"],
      "labels": ["Tiny", "Small", "Normal", "Large"],
      "values": { "web": [70, 90, 100, 130] },
      "default": "normal",
      "scope": "device",
      "parity": "drift",
      "note": "Same four names, different units: the website sets the interface size in percent of a CSS zoom (values, kept as a percent under its own key, 60 to 200 in steps of 10), the mod a GUI scale step relative to the game's. Kept.",
      "web": { "store": "src/lib/ui-scale.ts", "readIn": "src/lib/ui-scale-boot.ts", "key": "gtnh-factory-flow.ui-scale.v1", "control": { "box": "Board/Size" } },
      "mod": { "key": "board.planSize", "getter": "size", "setter": "setSize", "control": { "panel": "Board/Size" } }
    },
    "uiScalePercent": {
      "type": "int",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 100,
      "base": { "web": 1.17, "mod": 1 },
      "phoneBase": { "web": 0.9, "mod": 1 },
      "scope": "device",
      "parity": "web",
      "note": "The website's interface size as a percent. Size's four stops are four of its values; a custom percent from before stays valid.",
      "web": { "store": "src/lib/ui-scale.ts", "readIn": "src/lib/ui-scale-boot.ts", "key": "gtnh-factory-flow.ui-scale.v1", "control": { "box": "Board/Size" } }
    },

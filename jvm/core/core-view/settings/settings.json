      "mod": { "key": "board.peakPower", "getter": "peakPower", "setter": "setPeakPower", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/BoardSession.java", "marker": "PlannerSettings.setPeakPower(peakPower)" } }
    },

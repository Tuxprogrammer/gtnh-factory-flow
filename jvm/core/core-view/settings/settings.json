      "mod": { "key": "update.offered", "getter": "updateOffered", "setter": "setUpdateOffered", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/popup/UpdateOffer.java", "marker": "PlannerSettings.setUpdateOffered(release.tag())" } }
    },
    "solverEffortPercent": {
      "type": "int",
      "label": "Solver effort",
      "unit": "percent of the tuned default",
      "min": 25,
      "max": 200,
      "step": 1,
      "default": 100,
      "scope": "device",
      "parity": "mod",
      "note": "How long the mod's auto-balancing may look for a better answer. The website's solver runs on its own budget and has no such setting. Kept in the game's Forge config file, category solver, and edited there or in the mod's config screen.",
      "mod": { "key": "solverEffortPercent", "store": "forge-config", "category": "solver", "control": { "configFile": true } }
    },

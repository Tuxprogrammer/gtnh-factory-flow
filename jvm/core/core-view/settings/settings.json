      "type": "bool",
      "label": "Trend graphs open",
      "default": true,
      "scope": "device",
      "parity": "web",
      "web": { "store": "src/lib/workspace-view.ts", "key": "gtnh-factory-flow-workspace-view", "field": "trendsOpen", "control": { "file": "src/components/InspectorPanel.tsx", "marker": "writeWorkspaceView({ trendsOpen:" } }
    },
    "tourOffered": {
      "type": "bool",
      "label": "Tour offered",
      "default": false,
      "scope": "device",
      "parity": "shared",
      "note": "Answered once; either answer puts the first-run offer away for good. The website keeps the string 1 under its key.",
      "web": { "store": "src/components/flow/clean/tour/tour-store.ts", "key": "gtnhplanner.tour.offered", "control": { "file": "src/components/flow/clean/tour/TourOffer.tsx", "marker": "markTourOffered" } },
      "mod": { "key": "tour.offered", "getter": "tourOffered", "setter": "setTourOffered", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/TourOffer.java", "marker": "setTourOffered(true)" } }
    },
    "taskView": {
      "type": "choice",
      "label": "Task board view",
      "ids": ["board", "chain"],
      "labels": ["Board", "Chain"],
      "default": "board",
      "scope": "per-plan",
      "parity": "shared",
      "note": "Remembered per board on this device: the website keeps a map from design id (only chain is stored), the mod a key made of tasks.view. and the plan id.",
      "web": { "store": "src/lib/tasks/task-board-ui.ts", "key": "gtnhplanner.task-views.v1", "control": { "file": "src/components/chrome/BoardToolbar.tsx", "marker": "setTaskView(designId, each.id)" } },
      "mod": { "key": "tasks.view.", "keyIsPrefix": true, "getter": "taskView", "setter": "setTaskView", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/task/TaskBoardView.java", "marker": "PlannerSettings.setTaskView(" } }
    },
    "updateOffered": {
      "type": "text",
      "label": "Release told of",
      "default": "",

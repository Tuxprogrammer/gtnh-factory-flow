      "mod": { "key": "overview.open", "getter": "overviewOpen", "setter": "setOverviewOpen", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/OverviewRail.java", "marker": "PlannerSettings.setOverviewOpen(open)" } }

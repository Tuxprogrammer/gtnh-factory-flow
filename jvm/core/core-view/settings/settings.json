      "max": { "web": 480, "mod": 300 },
      "default": { "web": 336, "mod": 198 },
      "scope": "device",
      "parity": "drift",
      "note": "Both set it by dragging the overview's edge; the pixel spaces differ, so the range does. Kept.",
      "web": { "store": "src/lib/device-settings.ts", "key": "gtnh-factory-flow.device-settings.v1", "field": "overviewWidth", "control": { "file": "src/components/FactoryPlannerApp.tsx", "marker": "{ overviewWidth: width }" } },
      "mod": { "key": "overview.width", "getter": "overviewWidth", "setter": "setOverviewWidth", "control": { "file": "jvm/mod/src/main/java/com/gtnhplanner/ui/OverviewRail.java", "marker": "PlannerSettings.setOverviewWidth(wish)" } }
